# AutoQuote AI — Backend environment
# Copy to .env at repository root; never commit keys or passwords.
# Restart backend after changing provider/model (settings and clients are cached).

# auto | openai | google. auto prefers OpenAI, then Google; no API-error failover.
# Set google explicitly when OpenAI is configured only for RAG.
LLM_PROVIDER=auto
OPENAI_API_KEY=
GOOGLE_API_KEY=
# OpenAI chat model
MODEL_NAME=gpt-4o-mini
# Replace with a Google chat model available to your API account.
GOOGLE_MODEL_NAME=gemini-3.8-flash
LLM_TEMPERATURE=0.0
# RAG requires OPENAI_API_KEY even with Google chat: stored corpus uses
# text-embedding-3-small. Changing chat model does not change embeddings.

# Application PostgreSQL on Supabase. Copy the Session pooler string from Connect.
# URL-encode the password; keep it out of Git and frontend configuration.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres
# Optional isolated local development/test database: docker compose --profile local-db up -d postgres
# Optional host port if 5432 is occupied (update DATABASE_URL to match).
# POSTGRES_PORT=5433
# Optional fixed Compose project name for a persistent local instance.
# COMPOSE_PROJECT_NAME=autoquote-local
# DATABASE_URL=postgresql+asyncpg://vinfast:vinfast123@localhost:5432/vinfast_ai
# Cloud: copy your connection string and URL-encode password characters.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Compose backend uses the same DATABASE_URL as the directly started backend.
# Administrative connection for migrations and private data import.
# Prefer direct/session pooler; leave empty to use DATABASE_URL.
# AI data is stored in Supabase ai_data; no runtime dataset directory is needed.
MIGRATION_DATABASE_URL=
# Supabase hosts default to require; custom hosts can set require/verify-full.
# MIGRATION_SSLMODE=require

APP_NAME=AutoQuote AI
APP_ENV=development
# Required in production, use a cryptographically random secret of at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_DAYS=7
ZALO_BRIDGE_URL=http://127.0.0.1:8010
# Generate a separate random token (at least 32 characters); backend and bridge share it.
ZALO_BRIDGE_TOKEN=
# Bridge only: 32 random bytes in hex. Keep stable and back up securely.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZALO_SESSION_KEY=
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Pass host/port/log-level to uvicorn; these settings do not configure it directly.
# Docker CMD uses PORT supplied by Render, defaulting to 8000.

# Optional tracing; enable after supplying a real key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=autoquote-ai

# Optional Docker Compose frontend overrides.
# Manual frontend configuration belongs in frontend/.env.local.
# FRONTEND_PORT=3000
# BACKEND_URL=http://backend:8000
