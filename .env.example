# AutoQuote AI — Backend environment
# Copy to .env at repository root; never commit keys or passwords.
# Restart backend after changing provider/model (settings and clients are cached).

# auto | openai | google. auto prefers OpenAI, then Google; no API-error failover.
# Set google explicitly when OpenAI is configured only for RAG.
LLM_PROVIDER=auto
OPENAI_API_KEY=
GOOGLE_API_KEY=
# OpenAI chat model
MODEL_NAME=gpt-4o-mini
# Replace with a Google chat model available to your API account.
GOOGLE_MODEL_NAME=gemini-3.8-flash
LLM_TEMPERATURE=0.0
# RAG requires OPENAI_API_KEY even with Google chat: stored corpus uses
# text-embedding-3-small. Changing chat model does not change embeddings.

# Local PostgreSQL, matching: docker compose up -d postgres
DATABASE_URL=postgresql+asyncpg://vinfast:vinfast123@localhost:5432/vinfast_ai
# Cloud: copy your connection string and URL-encode password characters.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# Optional Compose backend override (otherwise uses hostname postgres).
# DOCKER_DATABASE_URL=postgresql+asyncpg://vinfast:vinfast123@postgres:5432/vinfast_ai
# Administrative connection used only by scripts/db/migrate_supabase.py.
# Prefer direct/session pooler; leave empty to use DATABASE_URL.
MIGRATION_DATABASE_URL=
# Supabase hosts default to require; custom hosts can set require/verify-full.
# MIGRATION_SSLMODE=require

APP_NAME=AutoQuote AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
# Pass host/port/log-level to uvicorn; these settings do not configure it directly.
# Docker CMD uses PORT supplied by Render, defaulting to 8000.

# Optional tracing; enable after supplying a real key.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=autoquote-ai

# Optional Docker Compose frontend overrides.
# Manual frontend configuration belongs in frontend/.env.local.
# FRONTEND_PORT=3000
# BACKEND_URL=http://backend:8000
